PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
JWT_SECRET=replace_with_long_random_secret
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:5173,http://localhost:4173
FRONTEND_URL=http://localhost:3002

# Admin bootstrap credentials
ADMIN_EMAIL=admin@questoria.com
ADMIN_PASSWORD=Admin@123

# Judge0
JUDGE0_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=your_rapidapi_key

# Gemini
GEMINI_API_KEY=your_gemini_api_key
# Optional aliases (same value as above, if you want to reuse frontend naming)
VITE_GEMINI_KEY=your_gemini_api_key
VITE_GEMINI_API_KEY=your_gemini_api_key

# Firebase Admin for Google OAuth token verification
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=your_service_account_email
# Use the *actual* service account private_key value from Firebase JSON, escaped with \n
# Example format: "-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Optional fallback for Google login token verification (same as frontend Firebase apiKey)
FIREBASE_WEB_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
